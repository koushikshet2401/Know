PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/knowbridge_marketing

JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=8h

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
FROM_EMAIL=noreply@knowbridge.io
NOTIFY_EMAIL=admin@knowbridge.io
SEND_ACK_EMAIL=true

FRONTEND_URL=http://localhost:3000

ADMIN_EMAIL=admin@knowbridge.io
ADMIN_PASSWORD=changeme123

GST_PERCENTAGE=18
INVOICE_PREFIX=KNB
