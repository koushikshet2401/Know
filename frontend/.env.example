# Next.js Public Config
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://knowbridge.io

# Dedicated SMTP Configuration (Loaded securely from environment only - no hardcoded credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="KnowBridge Leads" <your-email@example.com>
SMTP_TO=hello@knowbridge.io
